{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "さといも",
  "version": "0.1.0",
  "identifier": "jp.satoimo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "さといも",
      "width": 1280,
      "height": 760,
      "minWidth": 1100,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; media-src 'self' media: http://media.localhost asset: blob:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "shortDescription": "練習動画へ後付け実況を記録",
    "longDescription": "動画の再生操作、マイク実況、フリーハンド描画を記録し、解説動画を書き出します。",
    "copyright": "Copyright 2026 satoimo contributors",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": null
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
